{
  "name": "avl-tree-rust",
  "version": "2.1.2",
  "description": "High-performance native AVL tree library for Node.js.",
  "module": "index",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "napi build --release ./dist",
    "test:rust": "cargo test --all-targets",
    "test:node": "node --test test/*.test.js",
    "test": "npm run test:rust && npm run test:node",
    "benchmark:rust": "cargo bench --bench avl_tree",
    "benchmark:node": "node benchmark/node.js",
    "benchmark": "npm run benchmark:rust && npm run benchmark:node",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psht13/avl-tree.git"
  },
  "keywords": [
    "avl tree js",
    "algorithms",
    "binary trees",
    "self balancing tree"
  ],
  "author": "Pavlo Yurchenko <pashtet.gm@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/psht13/avl-tree/issues"
  },
  "homepage": "https://github.com/psht13/avl-tree#readme",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@napi-rs/cli": "^2.18.4",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.3"
  }
}
