+func samsungIMEInputRoutes(text, token string) []string {
+	encoded := strings.ReplaceAll(base64.StdEncoding.EncodeToString([]byte(text)), "\n", "")
+	query := "?token=" + url.QueryEscape(token)
+	raw := "remoteControl/imeInput/" + encoded + query
+	escaped := "remoteControl/imeInput/" + url.PathEscape(encoded) + query
+	if raw == escaped {
+		return []string{raw}
+	}
+	// Existing Samsung implementations use the raw base64 route. The escaped
+	// variant is retained as a fallback for HTTP stacks that interpret '/' in
+	// the encoded text as an extra path separator.
+	return []string{raw, escaped}
+}
+
+func (c *SamsungClient) sendTextREST(text string) error {
+	c.mu.RLock()
+	ip, token, preferredPort := c.ip, c.token, c.port
+	c.mu.RUnlock()
+	if strings.TrimSpace(ip) == "" {
+		return errors.New("Samsung TV IP невідомий")
+	}
+	if strings.TrimSpace(token) == "" {
+		return errors.New("Samsung IME API потребує збережений токен")
+	}
+
+	var lastErr error
+	for _, route := range samsungIMEInputRoutes(text, token) {
+		response, err := samsungRESTRequest(
+			ip,
+			http.MethodPost,
+			route,
+			nil,
+			preferredPort,
+			2200*time.Millisecond,
+		)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		if response.StatusCode >= 200 && response.StatusCode < 300 {
+			return nil
+		}
+		lastErr = fmt.Errorf("Samsung IME API на порту %d повернув %s", response.Port, response.Status)
+	}
+	if lastErr == nil {
+		lastErr = errors.New("Samsung IME API не прийняв текст")
+	}
+	return lastErr
+}
