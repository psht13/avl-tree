+func (c *SamsungClient) sendTextWebSocket(text string) error {
+	c.mu.RLock()
+	started := c.textStarted
+	imeActive := c.imeActive
+	c.mu.RUnlock()
+
+	if !started {
+		if err := c.Send(samsungTextReceivedCommand()); err != nil {
+			return err
+		}
+		c.mu.Lock()
+		c.textStarted = true
+		c.mu.Unlock()
+		// Several recent Tizen builds need a small gap after announcing the
+		// text session before accepting the first input packet.
+		time.Sleep(55 * time.Millisecond)
+	}
+
+	if err := c.Send(samsungInputStringCommand(text)); err != nil {
+		return err
+	}
+
+	// When Tizen explicitly reported an active IME session, keep that session
+	// open. This lets the user send another fragment without the TV dropping
+	// the field. Older firmwares do not emit imeStart, so finish the one-shot
+	// input after a short processing delay for compatibility.
+	if !imeActive {
+		time.Sleep(140 * time.Millisecond)
+		if err := c.Send(samsungInputEndCommand()); err != nil {
+			return err
+		}
+		c.mu.Lock()
+		c.textStarted = false
+		c.mu.Unlock()
+	}
+	c.log("Текст надіслано через Samsung WebSocket IME.")
+	return nil
+}
+
+func (c *SamsungClient) SendText(text string) error {
+	if strings.TrimSpace(text) == "" {
+		return errors.New("текст порожній")
+	}
+	c.textMu.Lock()
+	defer c.textMu.Unlock()
+
+	if c.Token() != "" {
+		if err := c.sendTextREST(text); err == nil {
+			c.log("Текст надіслано через Samsung secure IME API.")
+			return nil
+		} else {
+			c.log("Samsung secure IME API недоступний, використовую WebSocket: " + err.Error())
+		}
+	}
+	return c.sendTextWebSocket(text)
 }
 
