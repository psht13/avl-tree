+package remoteapp
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSamsungInputStringCommandUsesUTF8Base64(t *testing.T) {
+	t.Parallel()
+	text := "Привіт, Samsung"
+	command := samsungInputStringCommand(text)
+	payload, err := json.Marshal(command)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded struct {
+		Method string `json:"method"`
+		Params struct {
+			Cmd          string `json:"Cmd"`
+			DataOfCmd    string `json:"DataOfCmd"`
+			TypeOfRemote string `json:"TypeOfRemote"`
+		} `json:"params"`
+	}
+	if err := json.Unmarshal(payload, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.Method != "ms.remote.control" || decoded.Params.TypeOfRemote != "SendInputString" || decoded.Params.DataOfCmd != "base64" {
+		t.Fatalf("unexpected command: %#v", decoded)
+	}
+	if got := decoded.Params.Cmd; got != base64.StdEncoding.EncodeToString([]byte(text)) {
+		t.Fatalf("encoded text = %q", got)
+	}
+}
+
+func TestSamsungIMEInputRoutesContainTokenAndEncodedText(t *testing.T) {
+	t.Parallel()
+	routes := samsungIMEInputRoutes("a/b + тест", "token value")
+	if len(routes) == 0 {
+		t.Fatal("expected at least one IME route")
+	}
+	for _, route := range routes {
+		parsed, err := url.Parse("https://tv.local/api/v2/" + route)
+		if err != nil {
+			t.Fatalf("parse route %q: %v", route, err)
+		}
+		if parsed.Query().Get("token") != "token value" {
+			t.Fatalf("route does not preserve token: %q", route)
+		}
+		if parsed.Path == "/api/v2/remoteControl/imeInput/" {
+			t.Fatalf("route does not contain encoded text: %q", route)
+		}
+	}
+}
+
+func TestWriteConfigAtomicallyReplacesExistingFile(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.json")
+	if err := os.WriteFile(path, []byte("old"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeConfigAtomically(path, []byte("new")); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "new" {
+		t.Fatalf("config = %q", data)
+	}
+	if _, err := os.Stat(path + ".bak"); !os.IsNotExist(err) {
+		t.Fatalf("backup should be removed, got %v", err)
+	}
+}
