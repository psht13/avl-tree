+func (c *SamsungClient) prioritizeSamsungCandidates(candidates []samsungAppCandidate) ([]samsungAppCandidate, bool) {
+	ip := c.IP()
+	preferredPort := c.Port()
+	if ip == "" || len(candidates) < 2 {
+		return candidates, false
+	}
+	installed := make([]samsungAppCandidate, 0, len(candidates))
+	unknown := make([]samsungAppCandidate, 0, len(candidates))
+	stateSupported := false
+	for _, candidate := range candidates {
+		_, supported := fetchSamsungAppStatePreferred(ip, candidate.AppID, preferredPort, 450*time.Millisecond)
+		if supported {
+			stateSupported = true
+			installed = append(installed, candidate)
+		} else {
+			unknown = append(unknown, candidate)
+		}
+	}
+	return append(installed, unknown...), stateSupported
+}
