-		if err == nil {
-			_ = conn.Close()
-			return true
+	return canReachAnyTCPPort(ip, []string{"6466", "6467"}, timeout)
+}
+
+type providerReachability struct {
+	Samsung bool
+	Google  bool
+}
+
+func probeProviderReachability(ip string, timeout time.Duration) providerReachability {
+	samsungResult := make(chan bool, 1)
+	googleResult := make(chan bool, 1)
+	go func() { samsungResult <- canReachSamsung(ip, timeout) }()
+	go func() { googleResult <- canReachGoogleTV(ip, timeout) }()
+	return providerReachability{
+		Samsung: <-samsungResult,
+		Google:  <-googleResult,
+	}
+}
+
+func resolveProviderByReachability(requested string, reachability providerReachability) string {
+	switch {
+	case reachability.Google && !reachability.Samsung:
+		return ProviderGoogle
+	case reachability.Samsung && !reachability.Google:
+		return ProviderSamsung
+	default:
+		if requested == ProviderGoogle {
+			return ProviderGoogle
 		}
+		return ProviderSamsung
 	}
-	return false
 }
 
