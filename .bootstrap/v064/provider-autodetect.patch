+func canReachTCPPort(ip, port string, timeout time.Duration) bool {
+	conn, err := net.DialTimeout("tcp", net.JoinHostPort(ip, port), timeout)
+	if err != nil {
+		return false
+	}
+	_ = conn.Close()
+	return true
+}
+
+func canReachAnyTCPPort(ip string, ports []string, timeout time.Duration) bool {
+	results := make(chan bool, len(ports))
+	for _, port := range ports {
+		port := port
+		go func() {
+			results <- canReachTCPPort(ip, port, timeout)
+		}()
+	}
+	for range ports {
+		if <-results {
+			return true
+		}
+	}
+	return false
+}
+
 func canReachSamsung(ip string, timeout time.Duration) bool {
-	info, _ := fetchSamsungDeviceInfo(ip, timeout)
-	return info != nil
+	return canReachAnyTCPPort(ip, []string{"8002", "8001"}, timeout)
 }
 
