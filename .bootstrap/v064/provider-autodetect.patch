diff -ruN a/remoteapp/provider_detection_test.go b/remoteapp/provider_detection_test.go
--- a/remoteapp/provider_detection_test.go
+++ b/remoteapp/provider_detection_test.go
@@ -0,0 +1,27 @@
+package remoteapp
+
+import "testing"
+
+func TestResolveProviderByReachability(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name      string
+		requested string
+		reach     providerReachability
+		want      string
+	}{
+		{name: "google overrides stale samsung", requested: ProviderSamsung, reach: providerReachability{Google: true}, want: ProviderGoogle},
+		{name: "samsung overrides stale google", requested: ProviderGoogle, reach: providerReachability{Samsung: true}, want: ProviderSamsung},
+		{name: "both preserve google", requested: ProviderGoogle, reach: providerReachability{Samsung: true, Google: true}, want: ProviderGoogle},
+		{name: "both preserve samsung", requested: ProviderSamsung, reach: providerReachability{Samsung: true, Google: true}, want: ProviderSamsung},
+		{name: "neither preserves google", requested: ProviderGoogle, reach: providerReachability{}, want: ProviderGoogle},
+		{name: "invalid falls back samsung", requested: "", reach: providerReachability{}, want: ProviderSamsung},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := resolveProviderByReachability(test.requested, test.reach); got != test.want {
+				t.Fatalf("resolveProviderByReachability() = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
